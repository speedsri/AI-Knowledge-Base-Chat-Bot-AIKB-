name: docker

services:
  ...

version: "3.8"

services:
  app:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    container_name: aikb_app
    restart: unless-stopped
    ports:
      - "8080:80"
    env_file:
      - ../.env
    volumes:
      - ../storage:/var/www/html/storage
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - aikb_net

  mysql:
    image: mysql:8.0
    container_name: aikb_mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:-ai_kb}
      MYSQL_USER: ${DB_USERNAME:-ai_kb_app}
      MYSQL_PASSWORD: ${DB_PASSWORD:-change_me}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-change_me_root}
    volumes:
      - aikb_mysql_data:/var/lib/mysql
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${DB_ROOT_PASSWORD:-change_me_root}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - aikb_net

  # Optional. The application must run correctly with REDIS_ENABLED=false
  # and this service stopped/removed — see architecture doc §38.
  redis:
    image: redis:7-alpine
    container_name: aikb_redis
    restart: unless-stopped
    profiles: ["with-redis"]
    ports:
      - "6379:6379"
    networks:
      - aikb_net

networks:
  aikb_net:
    driver: bridge

volumes:
  aikb_mysql_data:
