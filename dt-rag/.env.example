# Copy to /home/docker/dt-rag/.env, chmod 600. Fill in real values.
# NEVER commit the filled-in .env to git or include it in any ZIP.

# ============ Internal auth ============
# V2 HARD REQUIREMENT: the application refuses to start if this is empty,
# whitespace-only, or under 32 characters (see app/config.py). Not optional.
RAG_INTERNAL_TOKEN=
# generate: openssl rand -hex 32
# AIKB (.220) and dt-admin4 (.215) will both need this SAME value in their
# own server-side config.

# ============ Gemini ============
# RE-VERIFY these model names against https://ai.google.dev/gemini-api/docs/models
# and https://ai.google.dev/gemini-api/docs/embeddings and
# https://ai.google.dev/gemini-api/docs/changelog before every deployment --
# this catalog changes on the order of weeks. As of this V2 patch:
#   - Gemini 2.5 Pro/Flash/Flash-Lite: scheduled shutdown 2026-10-16 -- DO NOT USE.
#   - gemini-3.7-flash: current GA workhorse Flash model.
#   - gemini-3.5-flash-lite: GA, cheap fallback tier.
#   - gemini-embedding-2: GA since 2026-04-22, preferred per policy over the
#     older gemini-embedding-001 absent a documented reason not to use it.
#     Does NOT use the task_type parameter (handled automatically in code
#     based on the model name -- see app/gemini_client.py).
GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.8-flash
GENERATION_FALLBACK_MODEL=gemini-3.5-flash-lite
# gemini-3.8-flash's own migration guide instructs removing temperature/
# top_p/top_k entirely -- app/gemini_client.py omits them automatically for
# this model (and defensively for 3.6/3.7). AIKB's temperature value is
# still accepted via /v1/config/sync; it is simply unused for this model.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
# Google recommends 768, 1536, or 3072. Both gemini-embedding-001 and
# gemini-embedding-2 use Matryoshka Representation Learning; embeddings are
# L2-normalized in code (app/gemini_client.py) per Google's documented
# requirement for MRL-truncated (< 3072) output dimensions.

# ============ Qdrant (internal only, no host port) ============
QDRANT_URL=http://rag-qdrant:6333
QDRANT_COLLECTION=dt_knowledge_base
QDRANT_STARTUP_RETRY_ATTEMPTS=10
QDRANT_STARTUP_RETRY_WAIT_SECONDS=3
# V2: rag-api itself retries connecting to Qdrant at startup with this
# bounded backoff, rather than relying on a Docker Compose healthcheck that
# assumed an unverified binary (wget) inside the Qdrant image. See
# docker-compose.yml's comments and ARCHITECTURE_PHASE_B.md item 7.

# ============ Retrieval defaults ============
TOP_K_DEFAULT=5
SIMILARITY_THRESHOLD_DEFAULT=0.72

# ============ Timeouts / batching ============
REQUEST_TIMEOUT=25
EMBED_BATCH_SIZE=32

# ============ Rate limiting ============
RATE_LIMIT_PER_MINUTE=120

# ============ Request size protection (V2 addition) ============
MAX_REQUEST_BODY_BYTES=2000000
# 2MB -- generous for legitimate /v1/reindex normalized_content, still bounded.
# Oversized requests receive HTTP 413. Raw oversized content is never logged.

# ============ Crawler safety defaults (overridable per-call) ============
CRAWLER_DEFAULT_MAX_PAGES=200
CRAWLER_DEFAULT_DELAY_SECONDS=1.5
CRAWLER_DEFAULT_TIMEOUT_SECONDS=20
CRAWLER_DEFAULT_MAX_DOC_SIZE_KB=2048
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_ALLOWLISTED_PRIVATE_RANGES=
# Comma-separated CIDRs, empty by default -- do not populate unless a
# specific, reviewed internal-crawl use case requires it. Loopback and
# multicast can NEVER be allow-listed regardless of this setting.

# ============ Logging ============
LOG_LEVEL=INFO
