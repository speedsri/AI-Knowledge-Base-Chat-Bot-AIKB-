# ==============================================================================
# Application
# ==============================================================================
APP_NAME="AI Knowledge Base"
APP_ENV=production            # local | production
APP_DEBUG=false               # NEVER true in production (controls error detail exposure)
APP_URL=https://ai.dynamictecsl.site
APP_TIMEZONE=Asia/Colombo

# Random 32-byte value used to sign session cookies / CSRF tokens.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ==============================================================================
# Encryption (used to encrypt API keys and other secrets stored in MySQL)
# Generate with: php -r "echo sodium_bin2hex(sodium_crypto_secretbox_keygen());"
# This key is read ONLY from .env, never stored in the database, never logged.
# ==============================================================================
SECRETS_ENCRYPTION_KEY=

# ==============================================================================
# MySQL
# ==============================================================================
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_kb
DB_USERNAME=ai_kb_app
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4

# ==============================================================================
# Sessions
# ==============================================================================
SESSION_NAME=aikb_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true

# ==============================================================================
# Redis (optional — app must run without it)
# ==============================================================================
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# File storage
# ==============================================================================
STORAGE_DOCUMENTS_PATH=/var/www/storage/documents
MAX_UPLOAD_SIZE_MB=25

# ==============================================================================
# AI Providers
# Actual per-provider model/temperature/priority live in the ai_providers table
# (admin-configurable). These env vars are only the raw API keys.
# ==============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# Rate limiting
# ==============================================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RAG_API_BASE=http://192.168.1.220:8500
RAG_INTERNAL_TOKEN=b90f56bc49238e4484d71b2c356db27db9a64c4d66fe642fb64c6cdee04f11bc
RAG_TIMEOUT_SECONDS=10
CHAT_GATEWAY_TOKEN=3126a3b7b54782a2126239119283b58f027d53a8b330575066f52ab88deb9873
